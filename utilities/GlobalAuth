import { chromium } from '@playwright/test';
import { request } from '@playwright/test';

async function globalSetupUI() {
    const browser = await chromium.launch();
    const page = await browser.newPage();

    await page.goto('https://www.automationexercise.com/login');
    await page.fill('input[data-qa="login-email"]', 'testuser01030@example.com');
    await page.fill('input[data-qa="login-password"]', 'password123');
    await page.click('button[data-qa="login-button"]');
    await page.waitForURL('https://www.automationexercise.com/');

    await page.context().storageState({
        path: '../config/auth/user.json'
    });

    await browser.close();
}

async function globalSetupAPI() {
    const requestContext = await request.newContext();
    await requestContext.post(
        'https://www.automationexercise.com/login',
        {
            form: {
                email: 'testuser01030@example.com',
                password: 'password123',
            }
        }
    );

    await requestContext.storageState({
        path: './config/auth/apiUser.json'
    });

    await requestContext.dispose();
}


async function setup() {
    await globalSetupUI();
    await globalSetupAPI();
}
export default  setup ;